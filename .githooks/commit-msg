#!/bin/sh
set -eu

message_file="$1"

subject="$(sed -n '1p' "$message_file")"

if ! printf '%s\n' "$subject" | grep -Eq '^(FEAT|FIX|CHORE|DOCS|TEST|REFACTOR|STYLE|PERF|BUILD|CI|REVERT)(\([A-Za-z0-9_-]+\))?: .+'; then
  cat >&2 <<'MSG'
Invalid commit subject.

Use an uppercase type:
  CHORE: Rust 워크스페이스 설정
  FEAT(core): 프로토콜 이벤트 추가

Allowed types:
  FEAT, FIX, CHORE, DOCS, TEST, REFACTOR, STYLE, PERF, BUILD, CI, REVERT
MSG
  exit 1
fi

if ! grep -q '^- 어떤 작업을 했는가:' "$message_file"; then
  echo 'Missing commit body field: - 어떤 작업을 했는가:' >&2
  exit 1
fi

if ! grep -q '^- 어떤 이슈인가:' "$message_file"; then
  echo 'Missing commit body field: - 어떤 이슈인가:' >&2
  exit 1
fi

if ! grep -q '^- 그래서 무엇을 했는가:' "$message_file"; then
  echo 'Missing commit body field: - 그래서 무엇을 했는가:' >&2
  exit 1
fi
